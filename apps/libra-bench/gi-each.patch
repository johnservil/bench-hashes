+    /// The IDs of many objects of one type: for BLAKE3, one call of the servil
+    /// fork's `hash_each_with`, short objects side by side in the SIMD lanes
+    /// (benchmark variant: bench-hashes apps/libra-bench, L4); otherwise one
+    /// [`Self::from_type_and_data_for_kind`] each.
+    pub fn each_for_kind(
+        kind: HashKind,
+        object_type: ObjectType,
+        items: &[&[u8]],
+    ) -> Result<Vec<ObjectHash>, HashError> {
+        if kind == HashKind::Blake3 {
+            let type_bytes = object_type.to_bytes().ok_or(HashError::UnsupportedObjectType {
+                operation: "each_for_kind",
+                kind,
+                object_type,
+                expected: kind.size(),
+                actual: 0,
+                payload_len: 0,
+            })?;
+            let context = format!("libra-tools git-internal 2026-09-04 {}", String::from_utf8_lossy(type_bytes));
+            let mut out = vec![[0u8; 32]; items.len()];
+            blake3::hash_each_with(blake3::Mode::DeriveKey(&context), items, &mut out);
+            return Ok(out.into_iter().map(ObjectHash::Blake3).collect());
+        }
+        items.iter().map(|data| Self::from_type_and_data_for_kind(kind, object_type, data)).collect()
+    }
+
